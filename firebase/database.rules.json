{
  "rules": {
    "sensors": {
      ".read": true,
      "$sensorId": {
        ".write": true,
        ".indexOn": ["timestamp", "deviceId", "waterLevel"]
      }
    },
    "simulation": {
      ".read": true,
      ".write": true
    },
    "live_alerts": {
      ".read": true,
      ".write": "auth != null"
    }
  }
}
