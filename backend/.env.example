# FloodGuard AI - Environment Configuration Example
PROJECT_NAME="FloodGuard AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000

# Security
SECRET_KEY="floodguard-super-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Firebase Configuration
# Path to serviceAccountKey.json or set FIREBASE_USE_EMULATOR=True / MOCK_MODE=True
FIREBASE_CREDENTIALS_PATH=""
FIREBASE_DATABASE_URL="https://floodguard-ai-default-rtdb.firebaseio.com"
FIREBASE_STORAGE_BUCKET="floodguard-ai.appspot.com"
FIREBASE_MOCK_MODE=True

# OpenStreetMap / GIS / Weather APIs (Optional fallback values included)
OPENWEATHER_API_KEY=""
MAPBOX_ACCESS_TOKEN=""

# CORS
CORS_ORIGINS=["*"]
